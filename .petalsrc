# .petalsrc: where coldframe's brand comes from. plotplot is the umbrella brand and the brand
# repository. coldframe's product layer is committed at .brand/products/coldframe/; the rest
# of .brand/ is fetched with petals' fetch-brand.sh at this version and git-ignored.
brand:
  source: https://github.com/jahala/plotplot.git
  version: v1.14.1
  product: coldframe
  overrides: {}
